{
  "configVersion": "v3",
  "app": {
    "appId": 1145141,
    "appName": "Spotify Remote",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "personal",
    "description": "Spotify remote control"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6",
      "target": "3.6",
      "minVersion": "3.6"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/control/index",
            "page/library/index",
            "page/queue/index",
            "page/devices/index",
            "page/volume/index"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Spotify Remote"
    },
    "ru-RU": {
      "appName": "Spotify Remote"
    }
  },
  "defaultLanguage": "en-US"
}
